{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "types": ["vite/client"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "vue": ["./node_modules/vue"],
      "illarion-client-core": ["./illarion-client-core/ui/src/index.ts"],
      "illarion-client-core/*": ["./illarion-client-core/ui/src/*"]
    }
  },
  "include": ["illarion-gobaith-ui/ui/**/*.ts", "illarion-gobaith-ui/ui/**/*.vue", "illarion-client-core/ui/**/*.ts"]
}
